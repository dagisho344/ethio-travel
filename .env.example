NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ethiotravel:ethiotravel@localhost:5432/ethiotravel?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
PAYMENT_PROVIDER=DEVELOPMENT
PAYMENT_DEVELOPMENT_WEBHOOK_SECRET=development-payment-webhook-secret-change-me
# AI remains disabled unless a server-only compatible provider is configured.
AI_PROVIDER=DISABLED
AI_BASE_URL=https://your-ai-provider.example/v1
AI_API_KEY=replace-with-server-only-provider-key
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=600
AI_REQUESTS_PER_HOUR=20
# Server-only storage configuration. LOCAL is suitable only for development/tests.
STORAGE_PROVIDER=LOCAL
STORAGE_DEVELOPMENT_ROOT=var/storage
S3_ENDPOINT=https://your-s3-compatible-endpoint.example
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=ethiotravel-public
S3_BUCKET_PRIVATE=ethiotravel-private
S3_ACCESS_KEY_ID=replace-with-server-only-access-key
S3_SECRET_ACCESS_KEY=replace-with-server-only-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://cdn.example/ethiotravel-public
S3_SIGNED_URL_TTL_SECONDS=300