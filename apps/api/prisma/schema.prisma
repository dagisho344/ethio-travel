generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                             String                   @id @default(uuid()) @db.Uuid
  email                          String                   @unique
  passwordHash                   String                   @map("password_hash")
  status                         UserStatus               @default(ACTIVE)
  emailVerifiedAt                DateTime?                @map("email_verified_at")
  lastLoginAt                    DateTime?                @map("last_login_at")
  createdAt                      DateTime                 @default(now()) @map("created_at")
  updatedAt                      DateTime                 @updatedAt @map("updated_at")
  profile                        UserProfile?
  roles                          UserRole[]
  sessions                       Session[]
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  businessMembers                BusinessMember[]
  submittedBusinessVerifications BusinessVerification[]   @relation("BusinessVerificationSubmittedBy")
  reviewedBusinessVerifications  BusinessVerification[]   @relation("BusinessVerificationReviewedBy")
  mediaAssets                    MediaAsset[]

  favorites            Favorite[]
  reviewsAuthored      Review[]               @relation("ReviewAuthor")
  reviewsModerated     Review[]               @relation("ReviewModerator")
  bookingsAuthored     Booking[]              @relation("BookingTraveler")
  bookingStatusChanges BookingStatusHistory[] @relation("BookingStatusChangedBy")
  paymentsMade         Payment[]              @relation("PaymentTraveler")

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  rotatedAt        DateTime? @map("rotated_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum LocationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  ARCHIVED
}

enum AttractionCategory {
  CULTURAL
  HISTORICAL
  NATURAL
  RELIGIOUS
  MUSEUM
  PARK
  MARKET
  ENTERTAINMENT
  LANDMARK
  OTHER
}

model Region {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  slug        String         @db.VarChar(180)
  description String?
  status      LocationStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  cities      City[]

  @@unique([slug])
  @@index([status])
  @@index([name])
  @@map("regions")
}

model City {
  id           String         @id @default(uuid()) @db.Uuid
  regionId     String         @map("region_id") @db.Uuid
  name         String         @db.VarChar(160)
  slug         String         @db.VarChar(180)
  description  String?
  latitude     Decimal        @db.Decimal(9, 6)
  longitude    Decimal        @db.Decimal(9, 6)
  status       LocationStatus @default(DRAFT)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  region       Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  destinations Destination[]
  businesses   Business[]

  @@unique([regionId, slug])
  @@index([regionId])
  @@index([status])
  @@index([name])
  @@index([latitude, longitude])
  @@map("cities")
}

model Destination {
  id               String             @id @default(uuid()) @db.Uuid
  cityId           String             @map("city_id") @db.Uuid
  name             String             @db.VarChar(180)
  slug             String             @db.VarChar(200)
  shortDescription String             @map("short_description") @db.VarChar(300)
  fullDescription  String             @map("full_description")
  latitude         Decimal            @db.Decimal(9, 6)
  longitude        Decimal            @db.Decimal(9, 6)
  travelInfo       Json?              @map("travel_info")
  status           PublicationStatus  @default(DRAFT)
  publishedAt      DateTime?          @map("published_at")
  archivedAt       DateTime?          @map("archived_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  city             City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  attractions      Attraction[]
  businesses       Business[]
  media            DestinationMedia[]

  favorites Favorite[]
  reviews   Review[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([status])
  @@index([name])
  @@index([latitude, longitude])
  @@map("destinations")
}

model Attraction {
  id            String             @id @default(uuid()) @db.Uuid
  destinationId String             @map("destination_id") @db.Uuid
  name          String             @db.VarChar(180)
  slug          String             @db.VarChar(200)
  category      AttractionCategory
  description   String
  latitude      Decimal            @db.Decimal(9, 6)
  longitude     Decimal            @db.Decimal(9, 6)
  entranceFee   Decimal?           @map("entrance_fee") @db.Decimal(12, 2)
  currency      String?            @db.Char(3)
  openingInfo   Json?              @map("opening_info")
  contactInfo   Json?              @map("contact_info")
  status        PublicationStatus  @default(DRAFT)
  publishedAt   DateTime?          @map("published_at")
  archivedAt    DateTime?          @map("archived_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  destination   Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  media         AttractionMedia[]

  favorites Favorite[]
  reviews   Review[]

  @@unique([destinationId, slug])
  @@index([destinationId])
  @@index([category])
  @@index([status])
  @@index([name])
  @@index([latitude, longitude])
  @@map("attractions")
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BusinessVerificationSummary {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VerificationDocumentType {
  BUSINESS_LICENSE
  TAX_DOCUMENT
  OWNER_ID
  ADDRESS_PROOF
  OTHER
}

model BusinessCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businesses Business[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("business_categories")
}

model Business {
  id                  String                      @id @default(uuid()) @db.Uuid
  cityId              String                      @map("city_id") @db.Uuid
  destinationId       String?                     @map("destination_id") @db.Uuid
  categoryId          String                      @map("category_id") @db.Uuid
  name                String                      @db.VarChar(180)
  slug                String                      @db.VarChar(200)
  description         String
  phone               String?                     @db.VarChar(40)
  email               String?                     @db.VarChar(254)
  website             String?                     @db.VarChar(2048)
  addressLine1        String                      @map("address_line_1") @db.VarChar(240)
  addressLine2        String?                     @map("address_line_2") @db.VarChar(240)
  neighborhood        String?                     @db.VarChar(120)
  postalCode          String?                     @map("postal_code") @db.VarChar(40)
  latitude            Decimal                     @db.Decimal(9, 6)
  longitude           Decimal                     @db.Decimal(9, 6)
  status              BusinessStatus              @default(DRAFT)
  verificationSummary BusinessVerificationSummary @default(NOT_SUBMITTED) @map("verification_summary")
  publishedAt         DateTime?                   @map("published_at")
  suspendedAt         DateTime?                   @map("suspended_at")
  archivedAt          DateTime?                   @map("archived_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  city          City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  destination   Destination?           @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  category      BusinessCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  members       BusinessMember[]
  verifications BusinessVerification[]
  services      Service[]
  media         BusinessMedia[]
  favorites     Favorite[]
  reviews       Review[]
  bookings      Booking[]
  payments      Payment[]

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([destinationId])
  @@index([categoryId])
  @@index([status])
  @@index([verificationSummary])
  @@index([name])
  @@index([latitude, longitude])
  @@index([status, verificationSummary, categoryId])
  @@map("businesses")
}

model BusinessMember {
  id         String               @id @default(uuid()) @db.Uuid
  businessId String               @map("business_id") @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  role       BusinessMemberRole
  status     BusinessMemberStatus @default(ACTIVE)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([businessId, role, status])
  @@map("business_members")
}

model BusinessVerification {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @map("business_id") @db.Uuid
  submittedByUserId String                    @map("submitted_by_user_id") @db.Uuid
  status            VerificationRequestStatus @default(PENDING)
  submittedAt       DateTime                  @default(now()) @map("submitted_at")
  reviewedAt        DateTime?                 @map("reviewed_at")
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.Uuid
  rejectionReason   String?                   @map("rejection_reason")
  adminNotes        String?                   @map("admin_notes")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  business        Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  submittedByUser User                   @relation("BusinessVerificationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser  User?                  @relation("BusinessVerificationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  documents       VerificationDocument[]

  @@index([businessId])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([submittedAt])
  @@map("business_verifications")
}

model VerificationDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  verificationId   String                   @map("verification_id") @db.Uuid
  type             VerificationDocumentType
  storageReference String                   @map("storage_reference") @db.VarChar(500)
  originalFilename String                   @map("original_filename") @db.VarChar(255)
  mimeType         String                   @map("mime_type") @db.VarChar(120)
  sizeBytes        Int                      @map("size_bytes")
  createdAt        DateTime                 @default(now()) @map("created_at")

  verification BusinessVerification @relation(fields: [verificationId], references: [id], onDelete: Restrict)

  @@index([verificationId])
  @@index([type])
  @@map("verification_documents")
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  ARCHIVED
}

enum PricingModel {
  FIXED
  PER_PERSON
  PER_NIGHT
  PER_HOUR
  PER_DAY
  STARTING_FROM
  FREE
  CONTACT_FOR_PRICE
}

enum ServiceLocationMode {
  BUSINESS_LOCATION
  CUSTOM_LOCATION
  MOBILE_VARIABLE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  PENDING_UPLOAD
  READY
  FAILED
  ARCHIVED
}

enum MediaRole {
  GALLERY
  HERO
  LOGO
}

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("service_categories")
}

model Service {
  id               String              @id @default(uuid()) @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  categoryId       String              @map("category_id") @db.Uuid
  name             String              @db.VarChar(180)
  slug             String              @db.VarChar(200)
  shortDescription String              @map("short_description") @db.VarChar(300)
  description      String
  price            Decimal?            @db.Decimal(12, 2)
  currency         String?             @db.Char(3)
  pricingModel     PricingModel        @map("pricing_model")
  durationMinutes  Int?                @map("duration_minutes")
  minGuests        Int?                @map("min_guests")
  maxGuests        Int?                @map("max_guests")
  locationMode     ServiceLocationMode @default(BUSINESS_LOCATION) @map("location_mode")
  address          String?             @db.VarChar(240)
  latitude         Decimal?            @db.Decimal(9, 6)
  longitude        Decimal?            @db.Decimal(9, 6)
  attributes       Json?
  status           ServiceStatus       @default(DRAFT)
  publishedAt      DateTime?           @map("published_at")
  archivedAt       DateTime?           @map("archived_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  business              Business                      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category              ServiceCategory               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media                 ServiceMedia[]
  favorites             Favorite[]
  reviews               Review[]
  bookingConfig         ServiceBookingConfig?
  availabilityRules     ServiceAvailabilityRule[]
  availabilityOverrides ServiceAvailabilityOverride[]
  bookings              Booking[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([pricingModel])
  @@index([name])
  @@index([price])
  @@index([latitude, longitude])
  @@index([status, categoryId, pricingModel])
  @@map("services")
}

model MediaAsset {
  id               String          @id @default(uuid()) @db.Uuid
  storageKey       String          @unique @map("storage_key") @db.VarChar(500)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(120)
  mediaType        MediaType       @map("media_type")
  sizeBytes        Int             @map("size_bytes")
  width            Int?
  height           Int?
  durationSeconds  Int?            @map("duration_seconds")
  checksum         String?         @db.VarChar(128)
  visibility       MediaVisibility @default(PUBLIC)
  status           MediaStatus     @default(PENDING_UPLOAD)
  createdByUserId  String          @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  createdBy        User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  businessMedia    BusinessMedia[]
  serviceMedia     ServiceMedia[]
  destinationMedia DestinationMedia[]
  attractionMedia  AttractionMedia[]

  @@index([createdByUserId])
  @@index([mediaType])
  @@index([visibility])
  @@index([status])
  @@map("media_assets")
}

model BusinessMedia {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  mediaId    String    @map("media_id") @db.Uuid
  role       MediaRole @default(GALLERY)
  sortOrder  Int       @default(0) @map("sort_order")
  altText    String?   @map("alt_text") @db.VarChar(240)
  caption    String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([businessId, mediaId])
  @@index([businessId])
  @@index([mediaId])
  @@index([role])
  @@index([sortOrder])
  @@map("business_media")
}

model ServiceMedia {
  id        String    @id @default(uuid()) @db.Uuid
  serviceId String    @map("service_id") @db.Uuid
  mediaId   String    @map("media_id") @db.Uuid
  role      MediaRole @default(GALLERY)
  sortOrder Int       @default(0) @map("sort_order")
  altText   String?   @map("alt_text") @db.VarChar(240)
  caption   String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([serviceId, mediaId])
  @@index([serviceId])
  @@index([mediaId])
  @@index([role])
  @@index([sortOrder])
  @@map("service_media")
}

model DestinationMedia {
  id            String    @id @default(uuid()) @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  mediaId       String    @map("media_id") @db.Uuid
  role          MediaRole @default(GALLERY)
  sortOrder     Int       @default(0) @map("sort_order")
  altText       String?   @map("alt_text") @db.VarChar(240)
  caption       String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  media       MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([destinationId, mediaId])
  @@index([destinationId])
  @@index([mediaId])
  @@index([role])
  @@index([sortOrder])
  @@map("destination_media")
}

model AttractionMedia {
  id           String    @id @default(uuid()) @db.Uuid
  attractionId String    @map("attraction_id") @db.Uuid
  mediaId      String    @map("media_id") @db.Uuid
  role         MediaRole @default(GALLERY)
  sortOrder    Int       @default(0) @map("sort_order")
  altText      String?   @map("alt_text") @db.VarChar(240)
  caption      String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Restrict)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([attractionId, mediaId])
  @@index([attractionId])
  @@index([mediaId])
  @@index([role])
  @@index([sortOrder])
  @@map("attraction_media")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

model Favorite {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  businessId    String?  @map("business_id") @db.Uuid
  serviceId     String?  @map("service_id") @db.Uuid
  destinationId String?  @map("destination_id") @db.Uuid
  attractionId  String?  @map("attraction_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  attraction  Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([businessId])
  @@index([serviceId])
  @@index([destinationId])
  @@index([attractionId])
  @@map("favorites")
}

model Review {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  moderatedById  String?      @map("moderated_by_id") @db.Uuid
  businessId     String?      @map("business_id") @db.Uuid
  serviceId      String?      @map("service_id") @db.Uuid
  destinationId  String?      @map("destination_id") @db.Uuid
  attractionId   String?      @map("attraction_id") @db.Uuid
  rating         Int
  title          String?      @db.VarChar(120)
  body           String?
  status         ReviewStatus @default(PENDING)
  moderationNote String?      @map("moderation_note")
  moderatedAt    DateTime?    @map("moderated_at")
  publishedAt    DateTime?    @map("published_at")
  hiddenAt       DateTime?    @map("hidden_at")
  rejectedAt     DateTime?    @map("rejected_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  author      User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  moderator   User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  attraction  Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([moderatedById])
  @@index([publishedAt])
  @@index([businessId, status])
  @@index([serviceId, status])
  @@index([destinationId, status])
  @@index([attractionId, status])
  @@map("reviews")
}

enum BookingMode {
  DATE
  DATE_RANGE
  TIME_SLOT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED_BY_TRAVELER
  CANCELLED_BY_BUSINESS
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum AvailabilityOverrideType {
  BLOCKED
  CAPACITY
}

model ServiceBookingConfig {
  id                   String      @id @default(uuid()) @db.Uuid
  serviceId            String      @unique @map("service_id") @db.Uuid
  enabled              Boolean     @default(false)
  bookingMode          BookingMode @default(TIME_SLOT) @map("booking_mode")
  timezone             String      @default("Africa/Addis_Ababa") @db.VarChar(80)
  capacity             Int         @default(1)
  minQuantity          Int         @default(1) @map("min_quantity")
  maxQuantity          Int         @default(1) @map("max_quantity")
  minDurationMinutes   Int?        @map("min_duration_minutes")
  maxDurationMinutes   Int?        @map("max_duration_minutes")
  advanceNoticeMinutes Int         @default(0) @map("advance_notice_minutes")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([enabled])
  @@index([bookingMode])
  @@map("service_booking_configs")
}

model ServiceAvailabilityRule {
  id         String    @id @default(uuid()) @db.Uuid
  serviceId  String    @map("service_id") @db.Uuid
  weekday    Int
  startTime  String    @map("start_time") @db.VarChar(5)
  endTime    String    @map("end_time") @db.VarChar(5)
  capacity   Int
  isActive   Boolean   @default(true) @map("is_active")
  validFrom  DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, weekday, isActive])
  @@index([validFrom, validUntil])
  @@map("service_availability_rules")
}

model ServiceAvailabilityOverride {
  id        String                   @id @default(uuid()) @db.Uuid
  serviceId String                   @map("service_id") @db.Uuid
  startAt   DateTime                 @map("start_at")
  endAt     DateTime                 @map("end_at")
  type      AvailabilityOverrideType @default(BLOCKED)
  capacity  Int?
  reason    String?                  @db.VarChar(300)
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, startAt, endAt])
  @@index([type])
  @@map("service_availability_overrides")
}

model Booking {
  id                   String        @id @default(uuid()) @db.Uuid
  reference            String        @unique @db.VarChar(32)
  serviceId            String        @map("service_id") @db.Uuid
  businessId           String        @map("business_id") @db.Uuid
  travelerId           String        @map("traveler_id") @db.Uuid
  startAt              DateTime      @map("start_at")
  endAt                DateTime      @map("end_at")
  quantity             Int           @default(1)
  guestCount           Int?          @map("guest_count")
  unitPrice            Decimal?      @map("unit_price") @db.Decimal(12, 2)
  subtotal             Decimal       @default(0) @db.Decimal(12, 2)
  currency             String?       @db.Char(3)
  pricingModelSnapshot PricingModel  @map("pricing_model_snapshot")
  bookingModeSnapshot  BookingMode   @map("booking_mode_snapshot")
  bookingStatus        BookingStatus @default(PENDING) @map("booking_status")
  paymentStatus        PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  travelerNote         String?       @map("traveler_note") @db.VarChar(1000)
  businessNote         String?       @map("business_note") @db.VarChar(1000)
  cancellationReason   String?       @map("cancellation_reason") @db.VarChar(1000)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  service  Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  business Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  traveler User                   @relation("BookingTraveler", fields: [travelerId], references: [id], onDelete: Restrict)
  history  BookingStatusHistory[]
  payments Payment[]

  @@index([travelerId, createdAt])
  @@index([businessId, createdAt])
  @@index([serviceId, startAt, endAt])
  @@index([bookingStatus, createdAt])
  @@index([paymentStatus])
  @@map("bookings")
}

enum PaymentProvider {
  DEVELOPMENT
  STRIPE
}

enum PaymentTransactionType {
  PAYMENT_INITIATED
  PROVIDER_AUTHORIZATION
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  REFUND_INITIATED
  REFUND_SUCCEEDED
  REFUND_FAILED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  travelerId        String          @map("traveler_id") @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(191)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  method            String?         @db.VarChar(80)
  idempotencyKey    String?         @map("idempotency_key") @db.VarChar(160)
  paidAt            DateTime?       @map("paid_at")
  failedAt          DateTime?       @map("failed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  traveler     User                 @relation("PaymentTraveler", fields: [travelerId], references: [id], onDelete: Restrict)
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      PaymentRefund[]

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId, createdAt])
  @@index([travelerId, createdAt])
  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  paymentId             String                   @map("payment_id") @db.Uuid
  type                  PaymentTransactionType
  providerTransactionId String?                  @map("provider_transaction_id") @db.VarChar(191)
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @db.Char(3)
  status                PaymentTransactionStatus @default(PENDING)
  providerMetadata      Json?                    @map("provider_metadata")
  createdAt             DateTime                 @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id               String                         @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  providerEventId  String                         @map("provider_event_id") @db.VarChar(191)
  eventType        String                         @map("event_type") @db.VarChar(160)
  payload          Json
  receivedAt       DateTime                       @default(now()) @map("received_at")
  processedAt      DateTime?                      @map("processed_at")
  processingStatus PaymentWebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  failureReason    String?                        @map("failure_reason") @db.VarChar(1000)

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model PaymentRefund {
  id               String              @id @default(uuid()) @db.Uuid
  paymentId        String              @map("payment_id") @db.Uuid
  providerRefundId String?             @map("provider_refund_id") @db.VarChar(191)
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @db.Char(3)
  reason           String?             @db.VarChar(500)
  status           PaymentRefundStatus @default(PENDING)
  idempotencyKey   String?             @map("idempotency_key") @db.VarChar(160)
  createdAt        DateTime            @default(now()) @map("created_at")
  completedAt      DateTime?           @map("completed_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@index([providerRefundId])
  @@map("payment_refunds")
}

model BookingStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  note        String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now()) @map("created_at")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  changedBy User?   @relation("BookingStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([changedById])
  @@index([toStatus, createdAt])
  @@map("booking_status_history")
}
